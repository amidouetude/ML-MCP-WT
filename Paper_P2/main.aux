\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Pitch command trace, rotor speed trace, and per-step solver \texttt  {ExitFlag} for GP (V1) and GP-v2 (V2) under the original $T=\SI {120}{s}$ protocol. The pitch command is frozen at its initial value for the full simulation in both cases ($\text  {std}=0$), and \texttt  {ExitFlag}$<0$ (solver infeasibility) at every one of the $1200$ steps tested, confirming the 'zero pitch activity' result is a frozen-actuator artifact rather than genuine regulation.}}{45}{figure.caption.43}\protected@file@percent }
\newlabel{fig:gp_frozen_actuator}{{20}{45}{Pitch command trace, rotor speed trace, and per-step solver \texttt {ExitFlag} for GP (V1) and GP-v2 (V2) under the original $T=\SI {120}{s}$ protocol. The pitch command is frozen at its initial value for the full simulation in both cases ($\text {std}=0$), and \texttt {ExitFlag}$<0$ (solver infeasibility) at every one of the $1200$ steps tested, confirming the 'zero pitch activity' result is a frozen-actuator artifact rather than genuine regulation}{figure.caption.43}{}}
